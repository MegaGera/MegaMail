<mjml>
  <mj-head>
    <mj-title>Welcome to MegaGoal</mj-title>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      .gradient-header {
        background: linear-gradient(135deg, #ffe0e3 0%, #ffb8c1 100%) !important;
      }
      .gradient-footer {
        background: linear-gradient(135deg, #ffe0e3 0%, #ffb8c1 100%) !important;
      }
      .email-container {
        border-radius: 12px !important;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-wrapper padding="20px 10px">
      <!-- Header Section with gradient -->
      <mj-section css-class="gradient-header email-container" background-color="#ffe0e3" border-radius="12px 12px 0 0" padding="20px 15px">
        <mj-column>
          <mj-image src="https://server.megamedia.megagera.com/megagera/MegaGoal.png" alt="MegaGoal" width="200px" align="center" padding="0" />
        </mj-column>
      </mj-section>
      
      <!-- Content Section -->
      <mj-section background-color="#ffffff" padding="30px 20px">
        <mj-column>
          <mj-text color="#333333" font-size="18px" line-height="1.6" padding-bottom="20px" padding-top="0">
            Welcome to MegaGoal{{USERNAME}}! 🎉
          </mj-text>
          
          <mj-text color="#555555" font-size="16px" line-height="1.8" padding-bottom="20px" padding-top="0">
            We're thrilled to have you join our community{{USERNAME}}! MegaGoal is a platform for football fans, created by a football fan. This is a <strong style="color: #dc143c;">brand new project and you are one of the first users</strong>, we're building something special together.
          </mj-text>
          
          <mj-text color="#555555" font-size="16px" line-height="1.8" padding-bottom="20px" padding-top="20px">
            By simply using the application, you're helping us grow and build an amazing community of passionate football enthusiasts. Every interaction, every feature you use, and every moment you spend on MegaGoal contributes to making this platform better for all of us. Sharing it really help us a lot too :)
          </mj-text>
          
          <mj-text color="#555555" font-size="16px" line-height="1.8" padding-bottom="20px" padding-top="20px">
            We'd love to hear your thoughts! Whether you have feedback, suggestions, or just want to share your experience, you can reach out to us through our <a href="https://megagoal.megagera.com/app/feedback" style="color: #dc143c; text-decoration: none; font-weight: 600;">feedback page</a> or connect with us on our <a href="https://x.com/MegaGoalApp" style="color: #dc143c; text-decoration: none; font-weight: 600;">X account</a>.
          </mj-text>
          
          <mj-text color="#555555" font-size="16px" line-height="1.8" padding-top="20px" padding-bottom="20px">
            There are a lot of more things coming in! Continue using the <a href="https://megagoal.megagera.com" style="color: #dc143c; text-decoration: none; font-weight: 600;">MegaGoal application at megagoal.megagera.com</a> to stay tuned of all the updates!
          </mj-text>
          
          <mj-text color="#666666" font-size="18px" align="left" padding-top="10px" padding-bottom="0">
            <strong style="color: #dc143c;">MegaGera</strong>
          </mj-text>
        </mj-column>
      </mj-section>
      
      <!-- Footer Section with gradient -->
      <mj-section css-class="gradient-footer email-container" background-color="#ffe0e3" border-radius="0 0 12px 12px" padding="20px 15px">
        <mj-column>
          <mj-image src="https://server.megamedia.megagera.com/megagera/MG_logo.png" alt="MegaGoal" width="250px" align="center" padding="0" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

