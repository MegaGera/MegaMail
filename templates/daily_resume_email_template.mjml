<mjml>
  <mj-head>
    <mj-title>Mega daily resume</mj-title>
    <mj-preview>Your MegaAuth + MegaGoal activity resume</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      .gradient-header {
        background: linear-gradient(135deg, #ffe0e3 0%, #ffb8c1 100%) !important;
      }
      .gradient-footer {
        background: linear-gradient(135deg, #ffe0e3 0%, #ffb8c1 100%) !important;
      }
      .email-container {
        border-radius: 12px !important;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;
      }
      .section-title {
        color: #dc143c !important;
        font-size: 18px !important;
        font-weight: 700 !important;
        letter-spacing: 0.02em !important;
        margin: 0 0 12px 0 !important;
      }
      .metric-row {
        border-bottom: 1px solid #f0f0f0;
        padding: 8px 0;
      }
      .metric-label {
        color: #666666;
        font-size: 14px;
      }
      .metric-value {
        color: #222222;
        font-size: 14px;
        font-weight: 700;
        float: right;
      }
      .chip {
        display: inline-block;
        background: #fff1f3;
        color: #dc143c;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        margin: 0 6px 6px 0;
      }
      .user-line {
        color: #444444;
        font-size: 13px;
        line-height: 1.5;
        margin: 0 0 4px 0;
      }
      .muted {
        color: #888888;
        font-size: 12px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-wrapper padding="20px 10px">
      <mj-section css-class="gradient-header email-container" background-color="#ffe0e3" border-radius="12px 12px 0 0" padding="20px 15px">
        <mj-column>
          <mj-image src="https://server.megamedia.megagera.com/megagera/MegaGoal.png" alt="MegaGoal" width="180px" align="center" padding="0" />
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="28px 24px 8px 24px">
        <mj-column>
          <mj-text color="#222222" font-size="22px" font-weight="700" padding-bottom="8px">
            Daily resume
          </mj-text>
          <mj-text color="#777777" font-size="13px" padding-bottom="18px">
            {{PERIOD_LABEL}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="8px 24px 20px 24px">
        <mj-column>
          <mj-text>
            <div class="section-title">MegaAuth</div>
            {{AUTH_HTML}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="8px 24px 28px 24px">
        <mj-column>
          <mj-text>
            <div class="section-title">MegaGoal</div>
            {{MEGAGOAL_HTML}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section css-class="gradient-footer email-container" background-color="#ffe0e3" border-radius="0 0 12px 12px" padding="20px 15px">
        <mj-column>
          <mj-image src="https://server.megamedia.megagera.com/megagera/MG_logo.png" alt="MegaGoal" width="220px" align="center" padding="0" />
          <mj-text align="center" color="#9a4a55" font-size="11px" padding-top="10px">
            Generated by MegaLog · delivered by MegaMail
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
